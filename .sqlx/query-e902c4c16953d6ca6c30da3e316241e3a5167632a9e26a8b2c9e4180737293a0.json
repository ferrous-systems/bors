{
  "db_name": "PostgreSQL",
  "query": "\n                SELECT\n                    check_run.id,\n                    build AS \"build!: BuildModel\",\n                    check_run.name,\n                    check_run.check_run_id,\n                    check_run.url,\n                    check_run.status as \"status: _\",\n                    check_run.started_at,\n                    check_run.github_workflow_run_id,\n                    check_run.github_app_id\n                FROM check_run\n                LEFT JOIN build ON check_run.build_id = build.id\n                WHERE build.id = $1\n            ",
